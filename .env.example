# ─── AI providers (choose one in Settings) ──────────────────────────────
# FREE — Google Gemini (recommended): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# FREE — Groq (very fast): https://console.groq.com/keys
GROQ_API_KEY=
# FREE — OpenRouter free vision models: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# PAID, optional — Anthropic Claude. Only used if you select it in Settings.
ANTHROPIC_API_KEY=

# ─── Optional research search ────────────────────────────────────────────
# FREE tier — Tavily open-web search for the Research Studio: https://app.tavily.com
TAVILY_API_KEY=

# ─── Optional asset providers ────────────────────────────────────────────
# Openverse, Wikimedia Commons and Iconify need no key and are always enabled.
# Unsplash: https://unsplash.com/oauth/applications (use the "Access Key")
UNSPLASH_ACCESS_KEY=
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=

# ─── Optional configuration ──────────────────────────────────────────────
# Where the SQLite database and stored files live (relative to the app folder).
DESIGNCRITIC_DATA_DIR=./data
# Contact string sent in the User-Agent to public APIs (Openverse/Wikimedia ask for one).
DESIGNCRITIC_CONTACT=designcritic-local
# Path to a Chromium-based browser for rendering. Leave empty to auto-detect Edge/Chrome.
DESIGNCRITIC_BROWSER_PATH=
# Max upload size in megabytes.
DESIGNCRITIC_MAX_UPLOAD_MB=20
